+/// The CLI in `directory` that converts AI/PDF/EPS previews: `illostrator-cli` (the Loloshop
+/// installer puts it beside Illostrator) or `vectorcraft-cli`, a regular file and not a link.
+pub(crate) fn adjacent_cli(directory: &std::path::Path) -> Option<std::path::PathBuf> {
+    let names: &[&str] = if cfg!(windows) { &["illostrator-cli.exe", "vectorcraft-cli.exe"] } else { &["illostrator-cli", "vectorcraft-cli"] };
+    names.iter().map(|name| directory.join(name)).find(|cli| std::fs::symlink_metadata(cli).is_ok_and(|m| m.is_file() && !m.file_type().is_symlink()))
+}
